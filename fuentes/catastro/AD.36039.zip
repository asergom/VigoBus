<!-- InstanceBeginEditable name="EditRegion5" -->
<script>
  // Reglas de transformación: de una URL antigua "tipo Catastro" a una URL nueva
  function proponerNuevaURL(urlOriginal) {
    try {
      const url = new URL(urlOriginal);

      let nuevoPath = url.pathname
        .replace(/(^|\/)esp(\/|$)/i, '$1es-ES$2')
        .replace(/\.asp(\b|$)/i, '.html')
        .replace(/\/{2,}/g, '/');

      const nuevaURL = new URL(url.href);
      nuevaURL.pathname = nuevoPath;

      return nuevaURL.toString();
    } catch {
      return null;
    }
  }

  // Comprueba si la URL existe detectando si redirige a la página 404 real
  async function urlExiste(url) {
    const URL_404 = "https://www.catastro.hacienda.gob.es/es-ES/404.html";

    try {
      const respuesta = await fetch(url, {
        method: 'GET',
        redirect: 'follow'
      });

      const urlFinal = respuesta.url;

      // Si la URL final es la página 404 → NO existe
      if (urlFinal === URL_404) return false;

      return true;
    } catch {
      return false;
    }
  }

  async function mostrarURLs404() {
    const params = new URLSearchParams(window.location.search);
    const urlFallida = params.get('u') || window.location.href;

    const nueva = proponerNuevaURL(urlFallida);

    const pAntigua = document.getElementById('url-antigua');
    const pNueva = document.getElementById('url-nueva');

    if (pAntigua) {
      pAntigua.textContent = `Página no encontrada: "${urlFallida}"`;
    }

    // Home del mismo dominio que la URL fallida
    let home;
    try {
      const u = new URL(urlFallida);
      u.pathname = "/";
      u.search = "";
      u.hash = "";
      home = u.toString();
    } catch {
      home = "/";
    }

    if (pNueva) {
      if (nueva && nueva !== urlFallida) {
        const existe = await urlExiste(nueva);

        if (existe) {
          pNueva.innerHTML = `Página con la nueva URL: "<a href="${nueva}">${nueva}</a>"`;
        } else {
          pNueva.innerHTML = `No se ha encontrado una alternativa válida. Puedes ir a la <a href="${home}">página de inicio</a>.`;
        }
      } else {
        pNueva.innerHTML = `No se ha podido proponer una nueva URL válida. Puedes ir a la <a href="${home}">página de inicio</a>.`;
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    mostrarURLs404();
  });
</script>




